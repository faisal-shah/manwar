# Non-secret Function parameters (the OAuth client secret is in Secret Manager
# as GOOGLE_OAUTH_CLIENT_SECRET). GOOGLE_OAUTH_CLIENT_ID must equal
# googleClientId in src/config.ts.
GOOGLE_OAUTH_CLIENT_ID=
HOUSEHOLD_EMAILS=household@example.com
ALLOWED_ORIGINS=https://manwar-home.web.app,https://manwar-home.firebaseapp.com,http://localhost:5173,http://localhost:4173
