rules_version = '2';
// Each wall signs in with a custom token carrying its household id (hid
// claim, minted by the connectGoogle Function); a paired phone's token also
// carries its device id (device claim, minted by redeemPairing), and the
// phone counts as a member only while its devices/{id} document exists, so
// removing a phone at the wall cuts it off at once. A member may read and
// write its household's collections; households/{hid}/private holds the
// Google refresh token, and pairings/ the pairing codes: both are reachable
// only through the Admin SDK. Devices are added and removed by the
// Functions; a phone may only stamp its own lastSeenAt.
//
// Stars: a device writes a check-off, its ledger entry and the balance in
// one batch, decided from its own copy, which can be stale (a phone offline
// checking off what the wall checked off meanwhile). The rules refuse the
// batch whole when another device got there first: a task state is only
// created (checked off, skipped) or deleted (unchecked, unskipped), never
// written over or deleted twice; a ledger entry is added, and marked undone
// once; a redemption may not take the balance below zero; and a one-time
// reward's redemption stamp is never written over.
service cloud.firestore {
  match /databases/{database}/documents {
    function deviceActive(hid) {
      return !('device' in request.auth.token)
        || exists(/databases/$(database)/documents/households/$(hid)/devices/$(request.auth.token.device));
    }
    function member(hid) {
      return request.auth != null && request.auth.token.hid == hid && deviceActive(hid);
    }
    match /households/{hid} {
      allow read: if member(hid);
      match /private/{doc} {
        allow read, write: if false;
      }
      match /devices/{id} {
        allow read: if member(hid);
        allow update: if member(hid)
          && request.auth.token.get('device', null) == id
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastSeenAt'])
          && request.resource.data.lastSeenAt is int;
      }
      match /taskStates/{id} {
        allow read, create: if member(hid);
        allow delete: if member(hid) && resource != null;
      }
      match /ledger/{id} {
        allow read: if member(hid);
        allow create: if member(hid)
          && (request.resource.data.reason != 'redeem'
            || getAfter(/databases/$(database)/documents/households/$(hid)/profiles/$(request.resource.data.profileId)).data.stars >= 0);
        allow update: if member(hid)
          && !('undoneAt' in resource.data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['undoneAt']);
      }
      match /rewards/{id} {
        allow read, create, delete: if member(hid);
        allow update: if member(hid)
          && request.resource.data.get('redeemedBy', {}).diff(resource.data.get('redeemedBy', {})).changedKeys().size() == 0;
      }
      match /{collection}/{docId} {
        allow read, write: if member(hid)
          && !(collection in ['private', 'devices', 'taskStates', 'ledger', 'rewards']);
      }
    }
  }
}
